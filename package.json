{
  "name": "bobocloud-workspace",
  "private": true,
  "description": "Convenience commands for the BOBOCLOUD client/server repository.",
  "scripts": {
    "start": "npm --prefix client run start",
    "dev": "npm --prefix client run dev",
    "test": "npm --prefix client run test",
    "typecheck": "npm --prefix client run typecheck",
    "test:ui": "npm --prefix client run test:ui",
    "build:renderer": "npm --prefix client run build:renderer",
    "build:win": "npm --prefix client run build:win",
    "build:win:internal": "npm --prefix client run build:win:internal",
    "build:mac": "npm --prefix client run build:mac",
    "build:linux": "npm --prefix client run build:linux",
    "audit:release": "npm --prefix client run audit:release",
    "docs:screenshots": "npm --prefix client run docs:screenshots",
    "test:server": "go -C server test ./...",
    "test:server:race": "go -C server test -race ./..."
  }
}
