ARG BASE_IMAGE=node:20-slim
FROM ${BASE_IMAGE}
ARG JS_DEBUG_VERSION=v1.102.0
ARG JS_DEBUG_SHA256=6eb0f9c9d5acc124a0cb4ee4e778adf57fb71f113d60aa6c303fc0c1501acc78
ARG JS_DEBUG_RELEASE_BASE=https://github.com/microsoft/vscode-js-debug/releases/download
ARG APT_DEBIAN_MIRROR=
ARG APT_SECURITY_MIRROR=
LABEL bobocloud.dap.adapter="vscode-js-debug" bobocloud.dap.version="${JS_DEBUG_VERSION}"
RUN if [ -n "$APT_DEBIAN_MIRROR" ]; then find /etc/apt -type f -name '*.sources' -o -name 'sources.list' | xargs -r sed -i "s|http://deb.debian.org/debian|${APT_DEBIAN_MIRROR}|g"; fi \
    && if [ -n "$APT_SECURITY_MIRROR" ]; then find /etc/apt -type f -name '*.sources' -o -name 'sources.list' | xargs -r sed -i "s|http://deb.debian.org/debian-security|${APT_SECURITY_MIRROR}|g"; fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl socat \
    && curl -fL --retry 5 --retry-all-errors \
      "${JS_DEBUG_RELEASE_BASE}/${JS_DEBUG_VERSION}/js-debug-dap-${JS_DEBUG_VERSION}.tar.gz" \
      -o /tmp/js-debug.tar.gz \
    && echo "${JS_DEBUG_SHA256}  /tmp/js-debug.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/js-debug.tar.gz -C /opt \
    && test -f /opt/js-debug/src/dapDebugServer.js \
    && rm -f /tmp/js-debug.tar.gz \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*
COPY js-debug-bridge.sh /usr/local/bin/bobocloud-js-debug-bridge
RUN chmod 0755 /usr/local/bin/bobocloud-js-debug-bridge
WORKDIR /workspace
# js-debug owns a parent DAP connection plus additional target connections.
# BOBOCloud brokers each of those connections through ticket-bound WSS child
# sessions; this server only listens inside the private DAP Docker network.
EXPOSE 4711
CMD ["/usr/local/bin/bobocloud-js-debug-bridge"]
