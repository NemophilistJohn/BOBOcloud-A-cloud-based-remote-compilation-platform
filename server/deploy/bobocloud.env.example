# Copy this file to /etc/bobocloud/bobocloud.env on the target host, then set
# ownership to root:root and mode 0600. Do not place secrets in this example,
# in the systemd unit, in source control, or in shell history.

# BOBOCLOUD_DATA_DIR=/var/lib/bobocloud
# BOBOCLOUD_LOG_LEVEL=info
# BOBOCLOUD_HTTP_READ_HEADER_TIMEOUT_SECONDS=10
# BOBOCLOUD_HTTP_IDLE_TIMEOUT_SECONDS=90
# BOBOCLOUD_HTTP_MAX_HEADER_BYTES=1048576
# BOBOCLOUD_SHUTDOWN_GRACE_PERIOD_SECONDS=15
# BOBOCLOUD_USER_DELETION_CLEANUP_RETRY_SECONDS=15

# Enable these together only after the TLS certificate and key are installed.
# BOBOCLOUD_TLS_ENABLED=true
# BOBOCLOUD_TLS_CERT_FILE=/etc/bobocloud/tls/server.crt
# BOBOCLOUD_TLS_KEY_FILE=/etc/bobocloud/tls/server.key

# Put sensitive values in the real 0600 file only when required. Do not add
# sample values here.
# BOBOCLOUD_ROOT_PASSWORD=
# BOBOCLOUD_ADMIN_API_KEY=
