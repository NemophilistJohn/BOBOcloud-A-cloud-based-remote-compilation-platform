# This file is read by the non-root `bobocloud` service account. The deployment
# preflight creates it as root:bobocloud with mode 0640. Keep the file in
# /etc/bobocloud, outside the release directory, and never place secrets in
# this example, the systemd unit, source control, or shell history.
#
# The supplied production unit pins TLS and the data root again at the final
# /usr/bin/env exec boundary, so an old env file cannot downgrade the listener
# or redirect it to a different certificate. The values below are useful for
# standalone/manual runs and document the expected production paths.

# BOBOCLOUD_DATA_DIR=/root/cloudeEditor/data
# BOBOCLOUD_SERVER_ROOT=/shareOnling
# BOBOCLOUD_LOG_LEVEL=info
# BOBOCLOUD_HTTP_READ_HEADER_TIMEOUT_SECONDS=10
# BOBOCLOUD_HTTP_IDLE_TIMEOUT_SECONDS=90
# BOBOCLOUD_HTTP_MAX_HEADER_BYTES=1048576
# BOBOCLOUD_SHUTDOWN_GRACE_PERIOD_SECONDS=15
# BOBOCLOUD_USER_DELETION_CLEANUP_RETRY_SECONDS=15

# Production TLS is mandatory. Install a certificate chain and private key in
# /etc/bobocloud/tls before applying a release. The unit sets these values
# explicitly; keep the comments here in sync for standalone execution.
# BOBOCLOUD_TLS_REQUIRED=true
# BOBOCLOUD_TLS_ENABLED=true
# BOBOCLOUD_TLS_CERT_FILE=/etc/bobocloud/tls/bobocloud.crt
# BOBOCLOUD_TLS_KEY_FILE=/etc/bobocloud/tls/bobocloud.key

# Put sensitive values in the real root:bobocloud 0640 file only when required.
# Do not add sample values here. The service account must be able to read the
# file, while other users must not.
# BOBOCLOUD_ROOT_PASSWORD=
# BOBOCLOUD_ADMIN_API_KEY=
