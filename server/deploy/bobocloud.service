[Unit]
Description=BOBOCLOUD Server (cloud compilation platform)
Documentation=https://github.com/bobocloud
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
BindsTo=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# The Go server does not use sd_notify, so Type=simple is intentional.
# Deploy-BoboCloudServer.ps1 waits for /healthz, /readyz, and serverInfo
# before considering a release successful.
Type=simple

# The server handles untrusted source and Docker-backed build workloads. It
# must never run as root. The docker group is the only host control-plane
# access it receives; the deployment preflight verifies that the group can
# actually reach the Docker socket before replacing a running release.
User=bobocloud
Group=bobocloud
SupplementaryGroups=docker
WorkingDirectory=/root/cloudeEditor

# Keep production secrets and per-host configuration out of this unit and Git.
# Unlike the development unit, a missing environment file is a startup error.
EnvironmentFile=/etc/bobocloud/bobocloud.env
# Keep these values visible in `systemctl cat` and in release policy checks.
# systemd gives EnvironmentFile= precedence over Environment=, so the critical
# values are also pinned as assignments to /usr/bin/env below.
Environment=BOBOCLOUD_TLS_REQUIRED=true
Environment=BOBOCLOUD_TLS_ENABLED=true
Environment=BOBOCLOUD_TLS_CERT_FILE=/etc/bobocloud/tls/bobocloud.crt
Environment=BOBOCLOUD_TLS_KEY_FILE=/etc/bobocloud/tls/bobocloud.key
# Keep the existing release data location for this migration. The provisioning
# step grants bobocloud ownership without copying or deleting user state.
Environment=BOBOCLOUD_DATA_DIR=/root/cloudeEditor/data

# Pin transport and state-root policy at the final exec boundary. This keeps a
# stale or operator-edited EnvironmentFile from downgrading TLS or redirecting
# writes outside the ownership-repaired data tree.
ExecStart=/usr/bin/env \
  BOBOCLOUD_TLS_REQUIRED=true \
  BOBOCLOUD_TLS_ENABLED=true \
  BOBOCLOUD_TLS_CERT_FILE=/etc/bobocloud/tls/bobocloud.crt \
  BOBOCLOUD_TLS_KEY_FILE=/etc/bobocloud/tls/bobocloud.key \
  BOBOCLOUD_DATA_DIR=/root/cloudeEditor/data \
  /root/cloudeEditor/bobocloud-server
ExecStartPre=/usr/bin/test -r /root/cloudeEditor/bobocloud-server
ExecStartPre=/usr/bin/test -f /root/cloudeEditor/bobocloud-server
ExecStartPre=/usr/bin/test ! -L /root/cloudeEditor/bobocloud-server
ExecStartPre=/usr/bin/test -r /root/cloudeEditor/config.json
ExecStartPre=/usr/bin/test -f /root/cloudeEditor/config.json
ExecStartPre=/usr/bin/test ! -L /root/cloudeEditor/config.json
ExecStartPre=/usr/bin/test -r /root/cloudeEditor/lsp_servers.json
ExecStartPre=/usr/bin/test -f /root/cloudeEditor/lsp_servers.json
ExecStartPre=/usr/bin/test ! -L /root/cloudeEditor/lsp_servers.json
ExecStartPre=/usr/bin/test -r /root/cloudeEditor/dap_adapters.json
ExecStartPre=/usr/bin/test -f /root/cloudeEditor/dap_adapters.json
ExecStartPre=/usr/bin/test ! -L /root/cloudeEditor/dap_adapters.json
ExecStartPre=/usr/bin/test -r /etc/bobocloud/tls/bobocloud.crt
ExecStartPre=/usr/bin/test -f /etc/bobocloud/tls/bobocloud.crt
ExecStartPre=/usr/bin/test ! -L /etc/bobocloud/tls/bobocloud.crt
ExecStartPre=/usr/bin/test -r /etc/bobocloud/tls/bobocloud.key
ExecStartPre=/usr/bin/test -f /etc/bobocloud/tls/bobocloud.key
ExecStartPre=/usr/bin/test ! -L /etc/bobocloud/tls/bobocloud.key
ExecStartPre=/usr/bin/test -f /etc/bobocloud/bobocloud.env
ExecStartPre=/usr/bin/test ! -L /etc/bobocloud/bobocloud.env
ExecStartPre=/usr/bin/test -S /run/docker.sock

# LSP/DAP dependency projections use host bind anchors. CAP_SYS_ADMIN is kept
# as the sole retained capability for that operation; it is deliberately paired
# with a non-root UID and NoNewPrivileges. PrivateMounts must remain disabled so
# Docker's daemon (outside this process) can see the anchors. A root-owned,
# path-allowlisted mount helper is the follow-up hardening item.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
PrivateMounts=false
NoNewPrivileges=true

# Process and kernel attack-surface reductions that do not create a private
# mount namespace (which would hide LSP/DAP anchors from Docker).
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectKernelLogs=false
ProtectControlGroups=false
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=true

# The service itself writes bounded logs, cache state, workspaces, and BoltDB
# data. Keep process-created files private and bound resource growth.
UMask=0077
LimitNOFILE=65536
TasksMax=4096
TimeoutStopSec=30
# Startup can initialize storage and Docker-backed services before it listens.
TimeoutStartSec=90
Restart=on-failure
RestartSec=3

# 日志走 journald（服务自身也写 data/logs/bobocloud.log）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
